# Copy to .env and fill in. Never commit the real .env.

# Option A: any SQLAlchemy URL (takes priority), e.g. Postgres on Render
# DATABASE_URL=postgresql://user:pass@host:5432/loan_analyzer

# Option B: MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=loan_analyzer
# If neither is reachable the API falls back to ./loan_analyzer.db (SQLite).

# JWT auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Code required to sign up as a bank officer (ADMIN). Leave empty to disable.
ADMIN_INVITE_CODE=

# Comma-separated list of allowed web origins (use * for development)
CORS_ORIGINS=*
MAX_UPLOAD_MB=10
